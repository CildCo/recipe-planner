page {
  --page: #eef4f4;
  --paper: #eef4f4;
  --paper-2: #e2eded;
  --card: #ffffff;
  --surface: #ffffff;
  --ink: #1f3a3d;
  --ink-2: #47666a;
  --muted: #556e71;
  --line: #d7e4e4;
  --line-strong: #b9cece;
  --primary: #1f6f78;
  --primary-dark: #185a61;
  --primary-soft: #dcebea;
  --leaf: #3b7a67;
  --leaf-soft: #ddece6;
  --accent: #b7d34a;
  --accent-soft: #f0f5df;
  --secondary: #4c6fa5;
  --secondary-soft: #e8eef7;
  --berry: #a34a5a;
  --berry-soft: #f2e7e9;
  --tomato: var(--primary);
  --tomato-dark: var(--primary-dark);
  --tomato-soft: var(--primary-soft);
  --olive: var(--leaf);
  --olive-soft: var(--leaf-soft);
  --mustard: #6d7d2d;
  --mustard-soft: var(--accent-soft);
  --plum: var(--secondary);
  --plum-soft: var(--secondary-soft);
  --jade: var(--leaf);
  --jade-soft: var(--leaf-soft);
  --sans: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  --mono: "SF Mono", "Roboto Mono", "Cascadia Mono", Consolas, monospace;
  --serif: var(--sans);
  background: var(--page);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 28rpx;
  line-height: 1.62;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea, image, scroll-view {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 80rpx;
}

.page.tight { padding-left: 0; padding-right: 0; }

.display {
  font-family: var(--sans);
  font-weight: 650;
  letter-spacing: -0.4rpx;
}

.eyebrow {
  font-family: var(--mono);
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: var(--primary);
  text-transform: uppercase;
}

.muted { color: var(--muted); }
.small { font-size: 22rpx; }
.serif { font-family: var(--sans); }

.page-title {
  font-family: var(--sans);
  font-size: 52rpx;
  line-height: 1.22;
  font-weight: 700;
  letter-spacing: -1rpx;
  margin: 10rpx 0 8rpx;
}

.page-lede {
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.7;
  margin: 0 0 28rpx;
}

.rule {
  height: 1px;
  background: var(--line);
  margin: 28rpx 0;
}

.rule.strong { background: var(--line-strong); }

.section {
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 14rpx;
  border-bottom: 1px solid var(--line);
  margin-bottom: 20rpx;
}

.section-title {
  font-family: var(--sans);
  font-size: 34rpx;
  font-weight: 650;
  letter-spacing: -0.3rpx;
}

.section-link {
  font-size: 22rpx;
  color: var(--primary);
}

.card {
  background: var(--card);
  border: 1px solid var(--line);
  border-radius: 14rpx;
  padding: 26rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 30rpx;
  border-radius: 10rpx;
  font-size: 27rpx;
  font-weight: 550;
  line-height: 1;
}

.btn::after { border: 0; }

.btn-primary {
  background: var(--primary);
  color: #ffffff;
}

.btn-primary:active { background: var(--primary-dark); }

.btn-ghost {
  border: 1px solid var(--line-strong);
  background: var(--surface);
  color: var(--ink);
}

.btn-ghost:active { background: var(--primary-soft); }

.btn-small {
  min-height: 60rpx;
  padding: 0 22rpx;
  font-size: 22rpx;
}

.btn-block { width: 100%; }

.tag {
  display: inline-block;
  font-size: 21rpx;
  color: var(--ink-2);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 8rpx;
  margin-bottom: 6rpx;
}

.tag-solid {
  background: var(--primary-soft);
  border-color: var(--primary-soft);
  color: var(--primary-dark);
}

.pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border: 1px solid var(--line-strong);
  border-radius: 99rpx;
  background: var(--surface);
  font-size: 22rpx;
  color: var(--ink-2);
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.pill.active {
  background: var(--primary);
  border-color: var(--primary);
  color: #ffffff;
}

.row {
  display: flex;
  align-items: center;
}

.between { justify-content: space-between; }

.cover-img {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--paper-2);
}

.progress {
  height: 10rpx;
  background: #cfe0df;
  border: 0;
  border-radius: 99rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: var(--accent);
  border-radius: 99rpx;
  transition: width 0.3s ease;
}

.meal-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 66rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border: 1px solid var(--line);
  border-radius: 6rpx;
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-size: 21rpx;
  line-height: 1;
}

.empty {
  padding: 70rpx 20rpx;
  text-align: center;
  color: var(--muted);
}

.empty-title {
  font-family: var(--sans);
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.safe-bottom {
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(31, 58, 61, 0.3);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  background: var(--surface);
  border-top: 1px solid var(--line);
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.22s ease;
}

.sheet.show { transform: translateY(0); }

.sheet-title {
  font-family: var(--sans);
  font-size: 34rpx;
  font-weight: 650;
  margin-bottom: 18rpx;
}

.field-label {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--muted);
  margin: 18rpx 0 10rpx;
}

.input {
  height: 78rpx;
  border: 1px solid var(--line-strong);
  border-radius: 8rpx;
  background: var(--surface);
  padding: 0 18rpx;
  font-size: 27rpx;
}

.toast {
  position: fixed;
  left: 50%;
  bottom: 180rpx;
  transform: translate(-50%, 20rpx);
  background: var(--primary);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 8rpx;
  padding: 16rpx 28rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease;
  z-index: 120;
}

.toast.show {
  opacity: 1;
  transform: translate(-50%, 0);
}

.check-circle {
  width: 38rpx;
  height: 38rpx;
  border: 1px solid var(--line-strong);
  border-radius: 50%;
  background: var(--surface);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: transparent;
  flex: 0 0 38rpx;
}

.check-circle.on {
  background: var(--leaf);
  border-color: var(--leaf);
  color: #ffffff;
}

.footer-mark {
  margin-top: 56rpx;
  padding-top: 20rpx;
  border-top: 1px solid var(--line);
  font-size: 21rpx;
  letter-spacing: 2rpx;
  color: var(--muted);
  text-align: center;
}
