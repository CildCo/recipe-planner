<view class="page favorites-page">
  <view class="fav-head">
    <text class="eyebrow">收藏</text>
    <view class="page-title">想再做一次</view>
    <view class="fav-sub">收藏不会占用菜单，先放着，想吃的时候再翻出来。</view>
  </view>

  <view class="fav-list" wx:if="{{items.length}}">
    <view class="recipe-item" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openRecipe">
      <recipe-card recipe="{{item}}" variant="row" />
    </view>
  </view>

  <empty-state
    wx:elif="{{!loading}}"
    title="还没有收藏"
    note="在菜谱详情页点一下星星，就会出现在这里。"
  />

  <view class="fav-actions" wx:if="{{!items.length && !loading}}">
    <view class="btn btn-ghost" bindtap="goRecipes">去看看菜谱</view>
  </view>

  <view class="footer-mark">饭桌 · 收藏</view>
</view>
