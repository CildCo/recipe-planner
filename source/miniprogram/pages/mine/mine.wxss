.mine-page { padding-top: 40rpx; }

.mine-head { padding-bottom: 24rpx; }

.house-card {
  border: 1px solid var(--line);
  border-radius: 16rpx;
  background: var(--surface);
  padding: 24rpx;
}

.house-top { display: flex; align-items: center; }

.house-mark {
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  background: var(--primary-soft);
  color: var(--primary-dark);
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 650;
}

.house-main { flex: 1; min-width: 0; margin-left: 18rpx; display: flex; flex-direction: column; }

.house-name { font-size: 33rpx; font-weight: 650; }

.house-sub { font-size: 21rpx; color: var(--muted); }

.house-edit { font-size: 22rpx; color: var(--primary); }

.invite-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1px solid var(--line);
}

.invite-label { font-size: 21rpx; color: var(--muted); width: 90rpx; }

.invite-value {
  flex: 1;
  font-family: var(--mono);
  font-size: 27rpx;
  letter-spacing: 6rpx;
}

.invite-copy { font-size: 22rpx; color: var(--primary); }

.member-stack { display: flex; margin-top: 16rpx; }

.member-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--primary-soft);
  color: var(--primary-dark);
  font-family: var(--sans);
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: -8rpx;
  border: 3rpx solid var(--surface);
}

.stat-row {
  display: flex;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 14rpx;
  overflow: hidden;
  margin-top: 16rpx;
}

.stat-cell {
  flex: 1;
  padding: 20rpx 10rpx;
  text-align: center;
  border-left: 1px solid var(--line);
}

.stat-cell:first-child { border-left: 0; }

.stat-num { font-family: var(--mono); font-size: 40rpx; font-weight: 600; display: block; line-height: 1.15; }

.stat-label { font-size: 21rpx; color: var(--muted); }

.menu-list {
  margin-top: 16rpx;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 14rpx;
  overflow: hidden;
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 22rpx 22rpx;
  border-bottom: 1px solid var(--line);
}

.menu-row:last-child { border-bottom: 0; }

.menu-main { flex: 1; display: flex; flex-direction: column; }

.menu-title { font-size: 27rpx; font-weight: 500; }

.menu-note { font-size: 21rpx; color: var(--muted); margin-top: 2rpx; }

.menu-arrow { font-size: 28rpx; color: var(--primary); }

.mine-foot {
  margin-top: 56rpx;
  padding-top: 18rpx;
  border-top: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  font-size: 21rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

.foot-mark { font-family: var(--mono); letter-spacing: 4rpx; }
